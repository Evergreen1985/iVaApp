{
  "expo": {
    "name": "iVa",
    "slug": "iva-intelliverify",
    "owner": "intelliverify",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "iva",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.intelliverify.iva",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ai.intelliverify.iva",
      "versionCode": 4,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withExpoModulesProguard",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow iVa to access your photos to upload class pictures.",
          "cameraPermission": "Allow iVa to take photos for the class gallery."
        }
      ],
      "expo-notifications",
      "expo-av",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow iVa to access your location to share the bus position with parents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7de2f5a6-633f-4f42-95a0-a224b66190b0"
      },
      "router": {}
    }
  }
}

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Google Play service-account key (NEVER commit)
google-play-key.json

# EAS local credentials (plaintext keystore passwords — NEVER commit)
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code
.claude/scheduled_tasks.lock

# Local archives / inspection dirs
IVAStmp-archive/
IVAStmp-inspect/
IVAStmp-inspect2/

# local dev server log
metro.log
apk-build.log
*.apk

# EAS command output logs / json dumps
eas-build.log
eas-list.json
eas-view.json

# local screenshots / scratch captures (repo root only)
/ft*.png
/g*.png
/qa*.png
/qe*.png
/qm*.png
/qr*.png
/rc*.png
